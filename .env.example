# Copy to .env.local (git ignores it) and fill in. Values come from
# Supabase -> Project settings -> API for project hxqyudcrlzkiqiwithke.
# Rename with the framework's public prefix (VITE_, NEXT_PUBLIC_, ...) when
# the stack is chosen: only the URL and anon key may be public.

# The app reads these two (Vite exposes VITE_* to the browser) for sign-in
# (decision 0015) and the agent. Without them, nobody can sign in.
# For local work, point them at `supabase start` (http://127.0.0.1:54321).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Rooted's AI service on Modal (decision 0016), e.g. https://<workspace>--rooted-ai-web.modal.run
# Without it, every AI feature says it isn't switched on.
VITE_AI_URL=

SUPABASE_URL=https://hxqyudcrlzkiqiwithke.supabase.co
SUPABASE_ANON_KEY=

# Server only. Never expose it to the browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
