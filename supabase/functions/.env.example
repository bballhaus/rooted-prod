# Secrets for the agent Edge Function (decision 0007). Copy to .env.local for
# `supabase functions serve agent --env-file supabase/functions/.env.local`.
# In the hosted project a person sets them with `supabase secrets set`.
# Leave them empty and the function answers not_configured; the app then uses
# its labelled sample answers.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Local testing only: lets the mocked-sign-in app reach the LLM. Never set this
# on the hosted project, or anyone with the public anon key can spend the key.
AGENT_ALLOW_ANONYMOUS=
